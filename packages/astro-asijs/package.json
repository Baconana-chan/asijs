{
  "name": "@asijs/astro",
  "version": "0.1.0",
  "description": "Astro adapter for AsiJS — run AsiJS as Astro server endpoints and API routes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --external asijs --external astro",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": ["asijs", "astro", "adapter", "server-endpoints"],
  "peerDependencies": {
    "asijs": "latest",
    "astro": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
