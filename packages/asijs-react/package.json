{
  "name": "asijs-react",
  "version": "1.0.0",
  "description": "React Server Components for AsiJS — RSC rendering pipeline, server/client boundaries, streaming SSR + hydration, createRSCHandler adapter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --external asijs --external react --external react-dom --external react-server-dom-webpack",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": ["asijs", "react", "rsc", "server-components", "ssr", "streaming", "hydration", "adapter"],
  "license": "MIT",
  "peerDependencies": {
    "asijs": "latest",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-server-dom-webpack": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "asijs": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-server-dom-webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
