# ===== AsiJS Docker Example — Environment Variables =====
# Copy this file to .env and adjust for your deployment

# App
APP_PORT=3000
NODE_ENV=production

# PostgreSQL
PG_USER=asijs
PG_PASSWORD=asijs
PG_DB=asijs
PG_PORT=5432

# Redis
REDIS_PORT=6379

# Security (change in production!)
SESSION_SECRET=change-me-in-production

# Rate Limiting
ASIJS_RATE_LIMIT_MAX=1000
ASIJS_RATE_LIMIT_WINDOW_MS=60000

# Adminer (optional DB UI, enable with: docker compose --profile admin up)
ADMINER_PORT=8080
