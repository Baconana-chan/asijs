{
  "name": "asijs",
  "version": "1.4.0",
  "description": "Bun-first web framework — fast, type-safe, simple",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "asijs": "dist/cli.js",
    "create-asijs": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "default": "./dist/i18n.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "default": "./dist/edge.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js",
      "default": "./dist/database.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js",
      "default": "./dist/metrics.js"
    },
    "./codemod": {
      "types": "./dist/codemod.d.ts",
      "import": "./dist/codemod.js",
      "default": "./dist/codemod.js"
    },
    "./node": {
      "types": "./dist/runtime/node/index.d.ts",
      "import": "./dist/runtime/node/index.js",
      "default": "./dist/runtime/node/index.js"
    },
    "./spa": {
      "types": "./dist/spa.d.ts",
      "import": "./dist/spa.js",
      "default": "./dist/spa.js"
    },
    "./spa-client": {
      "types": "./dist/spa-client.d.ts",
      "import": "./dist/spa-client.js",
      "default": "./dist/spa-client.js"
    },
    "./structured-logger": {
      "types": "./dist/structured-logger.d.ts",
      "import": "./dist/structured-logger.js",
      "default": "./dist/structured-logger.js"
    },
    "./sentry": {
      "types": "./dist/sentry.d.ts",
      "import": "./dist/sentry.js",
      "default": "./dist/sentry.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js",
      "default": "./dist/redis.js"
    },
    "./json-stream": {
      "types": "./dist/json-stream.d.ts",
      "import": "./dist/json-stream.js",
      "default": "./dist/json-stream.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run --hot index.ts",
    "start": "bun run index.ts",
    "test": "bun test",
    "bench": "bun --cwd bench run index.ts",
    "bench:production": "bun --cwd bench run production.ts",
    "bench:fullstack": "bun --cwd bench run fullstack.ts",
    "bench:collect": "cd bench && bun run collect.ts",
    "bench:dashboard": "cd bench && bun run generate-dashboard.ts",
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts src/cli.ts src/jsx-runtime.ts src/jsx-dev-runtime.ts src/i18n.ts src/edge.ts src/testing.ts src/database.ts src/rpc.ts src/client.ts src/workspace.ts src/metrics.ts src/codemod.ts src/spa.ts src/spa-client.ts src/structured-logger.ts src/sentry.ts src/json-stream.ts src/redis.ts src/serverless.ts --outdir dist --target node --minify --external @sinclair/typebox --splitting && bun build src/runtime/node/index.ts --outdir dist/runtime/node --target node --external @sinclair/typebox --external ws --external ioredis --splitting",
    "build:types": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --project tsconfig.examples.json --noEmit",
    "check:examples": "bun run typecheck:examples && bun run scripts/check-examples.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "bun run typecheck && bun test",
    "prepublishOnly": "bun run check && bun run build",
    "publish:jsr": "bunx jsr publish",
    "publish:packages": "bash scripts/publish-packages.sh",
    "publish:packages:dry": "bash scripts/publish-packages.sh --dry-run"
  },
  "keywords": [
    "bun",
    "web",
    "framework",
    "http",
    "server",
    "fast",
    "typescript",
    "jsx",
    "api",
    "rest",
    "openapi",
    "swagger",
    "websocket",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baconana-chan/asijs.git"
  },
  "homepage": "https://github.com/Baconana-chan/asijs#readme",
  "bugs": {
    "url": "https://github.com/Baconana-chan/asijs/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.1",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "ioredis": "^5.11.1",
    "ws": "^8.21.1"
  }
}
